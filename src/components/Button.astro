---
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { href, variant = "primary", size = "md", class: className = "" } = Astro.props;
const external = typeof href === "string" && /^https?:\/\//.test(href);
const cls = ["btn", `btn-${variant}`, size !== "md" ? `btn-${size}` : "", className]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a class={cls} href={href} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
      <slot />
    </a>
  ) : (
    <button class={cls} type="button">
      <slot />
    </button>
  )
}
