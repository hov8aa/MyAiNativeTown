---
import { copyFor, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const dmHref = "https://wa.me/917015330518?text=AGENT";
const t = copyFor(Astro.props.lang).footer;
---

<footer class="site-footer">
  <div class="wrap">
    <hr class="divider-gold" />
    <div class="row">
      <span class="line">{t.line}</span>
      <div class="links">
        <a href={dmHref} data-cta="footer">WhatsApp</a>
        <a href="https://github.com/hov8aa/MyAiNativeTown">GitHub</a>
        <a href="https://www.youtube.com/@AgentforceWithHov8a">YouTube</a>
        <a href="https://www.instagram.com/myainativetown">Instagram</a>
        <a href="#">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-canvas); padding: 32px 24px; }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    row-gap: 12px;
    margin-top: 24px;
  }

  .line { font-size: 0.875rem; color: var(--text-subtle); }

  .links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .links a { text-decoration: none; font-weight: 500; font-size: 0.875rem; }
</style>
