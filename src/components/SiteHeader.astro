---
import Button from "./Button.astro";
import { copyFor, langFrom, languages, pathFor, type Lang } from "../i18n";

const dmHref = "https://wa.me/917015330518?text=AGENT";
const lang = langFrom(Astro.currentLocale);
const t = copyFor(lang).header;
---

<header class="site-header">
  <a href="#top" class="brand">
    <span class="brand-name">My<span class="gold">Ai</span>NativeTown</span>
    <span class="brand-loc">{t.brandLoc}</span>
  </a>
  <nav aria-label="Primary">
    <a href="#questions">{t.nav.questions}</a>
    <a href="#building">{t.nav.building}</a>
    <a href="#tracks">{t.nav.tracks}</a>
    <a href="#format">{t.nav.format}</a>
    <a href="#register">{t.nav.register}</a>
  </nav>
  <div class="actions">
    <nav class="lang-switch" aria-label={t.languageLabel}>
      {(Object.keys(languages) as Lang[]).map((l) => (
        <a
          href={pathFor(l)}
          hreflang={l}
          lang={l}
          data-lang={l}
          aria-current={l === lang ? "true" : undefined}
        >
          {languages[l]}
        </a>
      ))}
    </nav>
    <Button size="sm" href={dmHref} data-cta="header">{t.cta}</Button>
  </div>
</header>

<script is:inline>
  // Remember the visitor's pick; Base.astro reads it on the next landing.
  document.querySelectorAll('.lang-switch a').forEach(function (a) {
    a.addEventListener('click', function () {
      try { localStorage.setItem('lang', a.getAttribute('data-lang')); } catch (e) {}
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    row-gap: 12px;
    padding: 20px 24px;
    background: rgba(7, 22, 39, 0.82);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border-hairline);
  }

  .brand {
    text-decoration: none;
    display: grid;
    gap: 2px;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--text-heading);
  }

  .brand-loc {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
    font-weight: 500;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  nav a {
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  nav a:hover { color: var(--gold-200, #fbe3a2); }

  .actions { display: flex; align-items: center; gap: 16px; }

  .lang-switch {
    gap: 0;
    padding: 3px;
    border: 1px solid var(--border-gold-soft);
    border-radius: var(--radius-pill);
  }

  .lang-switch a {
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .lang-switch a[aria-current] {
    background: var(--surface-gold-tint);
    color: var(--gold-300);
  }
</style>
