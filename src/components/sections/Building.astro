---
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).building;
const accents = ["var(--gold-400)", "var(--gold-500)", "var(--gold-600)"];
const layers = t.layers.map((layer, i) => ({ ...layer, accent: accents[i] }));
---

<div class="building">
  <p class="eyebrow">{t.eyebrow}</p>
  <h2>{t.title}<span class="gold">{t.titleGold}</span>{t.titleEnd}</h2>
  <p class="deck">{t.deck}</p>
  <div class="layers">
    {layers.map((layer) => (
      <div class="layer" style={`border-left-color:${layer.accent}`}>
        <p class="tag">{layer.tag}</p>
        <p class="text">{layer.text}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .building h2 { margin: 0 0 20px; }
  .deck { font-size: 1.0625rem; line-height: 1.55; margin: 0 0 24px; max-width: 48ch; }

  .layers { display: grid; gap: 12px; }

  .layer {
    background: var(--surface-inset);
    border-left: 3px solid;
    border-radius: 14px;
    padding: 16px 20px;
  }

  .tag {
    margin: 0 0 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }

  .text { margin: 0; font-size: 1rem; color: var(--text-body); line-height: 1.55; max-width: none; }
</style>
