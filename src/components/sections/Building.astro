---
const layers = [
  {
    tag: "Layer 01 · Sessions 1–8",
    text: "The category walk. What the town actually asks for, written down before any model is touched.",
    accent: "var(--gold-400)",
  },
  {
    tag: "Layer 02 · Sessions 9–18",
    text: "Tools, data and guardrails. The first wrong answer arrives here, and we keep it.",
    accent: "var(--gold-500)",
  },
  {
    tag: "Layer 03 · Sessions 19–26",
    text: "Into a real workflow, in one real shop or clinic. It moved the number, or it did not.",
    accent: "var(--gold-600)",
  },
];
---

<div class="building">
  <p class="eyebrow">What we&rsquo;re building</p>
  <h2>One town agent, <span class="gold">teen layers mein</span>.</h2>
  <p class="deck">
    Not nine demos. One agent for this district, built layer by layer in
    front of you, with every wrong answer logged where you can read it.
  </p>
  <div class="layers">
    {layers.map((layer) => (
      <div class="layer" style={`border-left-color:${layer.accent}`}>
        <p class="tag">{layer.tag}</p>
        <p class="text">{layer.text}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .building h2 { margin: 0 0 20px; }
  .deck { font-size: 1.0625rem; line-height: 1.55; margin: 0 0 24px; max-width: 48ch; }

  .layers { display: grid; gap: 12px; }

  .layer {
    background: var(--surface-inset);
    border-left: 3px solid;
    border-radius: 14px;
    padding: 16px 20px;
  }

  .tag {
    margin: 0 0 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }

  .text { margin: 0; font-size: 1rem; color: var(--text-body); line-height: 1.55; max-width: none; }
</style>
