---
import Button from "../Button.astro";
import { copyFor } from "../../i18n";

const dmHref = "https://wa.me/917015330518?text=AGENT";
const copy = copyFor(Astro.currentLocale);
const t = copy.closing;
---

<section class="closing">
  <div class="wrap">
    <p class="eyebrow">{t.eyebrow}</p>
    <p class="statement">
      {t.statement}<span class="gold">{t.statementGold}</span>
    </p>
    <Button size="lg" href={dmHref} data-cta="closing">{copy.dmCta}</Button>
  </div>
</section>

<style>
  .closing { padding: 80px 24px; }
  .closing .wrap { max-width: 900px; text-align: center; }

  .statement {
    margin: 0 0 32px;
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: var(--text-heading);
    max-width: none;
  }
</style>
