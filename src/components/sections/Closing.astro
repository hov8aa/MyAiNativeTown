---
import Button from "../Button.astro";

const dmHref = "https://wa.me/917015330518?text=AGENT";
const dmCta = `DM "AGENT" to know more`;
---

<section class="closing">
  <div class="wrap">
    <p class="eyebrow">Before you decide</p>
    <p class="statement">
      You will spend ninety days pushing a real thing into a town that did
      not ask for it. <span class="gold">Most of it will resist.</span>
    </p>
    <Button size="lg" href={dmHref}>{dmCta}</Button>
  </div>
</section>

<style>
  .closing { padding: 80px 24px; }
  .closing .wrap { max-width: 900px; text-align: center; }

  .statement {
    margin: 0 0 32px;
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: var(--text-heading);
    max-width: none;
  }
</style>
