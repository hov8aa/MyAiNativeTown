---
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).dontJoin;
---

<div class="card card-inset dontjoin">
  <p class="eyebrow">{t.eyebrow}</p>
  <h3>{t.title}</h3>
  <div class="lines">
    {t.reasons.map((r) => <p>{r}</p>)}
  </div>
</div>

<style>
  .dontjoin h3 { margin: 0 0 20px; }
  .lines { display: grid; gap: 12px; }
  .lines p { margin: 0; font-size: 0.9375rem; line-height: 1.55; max-width: none; }
</style>
