---
const reasons = [
  "you want a certificate more than a working thing.",
  "you cannot make three fixed evenings a week for nine weeks.",
  "you expect to be handed the goal instead of chasing it between sessions.",
  "you need the recording, because there isn’t one.",
];
---

<div class="card card-inset dontjoin">
  <p class="eyebrow">Don&rsquo;t join if</p>
  <h3>Yeh aapke liye nahi hai, agar &mdash;</h3>
  <div class="lines">
    {reasons.map((r) => <p>{r}</p>)}
  </div>
</div>

<style>
  .dontjoin h3 { margin: 0 0 20px; }
  .lines { display: grid; gap: 12px; }
  .lines p { margin: 0; font-size: 0.9375rem; line-height: 1.55; max-width: none; }
</style>
