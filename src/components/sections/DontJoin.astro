---
const reasons = [
  "You want a certificate more than a working thing.",
  "You want the recording. There isn't one.",
  "You want to be taught. This is closer to being handed a piece and expected to carry it.",
  "Three hours in the room, and the hours outside it, every week until mid-November, is not something you can actually give.",
];
---

<section class="dontjoin">
  <div class="wrap">
    <h2>Don't join if</h2>
    <ul>
      {reasons.map((r) => <li>{r}</li>)}
    </ul>
    <p class="close">
      I'd rather have four people still in the room in November than forty who
      registered in September.
    </p>
  </div>
</section>

<style>
  .dontjoin ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .dontjoin li {
    padding: 0.9rem 0 0.9rem 1.75rem;
    border-bottom: 1px solid var(--rule);
    position: relative;
  }

  .dontjoin li::before {
    content: "\00d7";
    position: absolute;
    left: 0;
    top: 0.85rem;
    color: var(--sarson-deep);
    font-size: 1.15rem;
    line-height: 1.4;
  }

  .close {
    margin-top: 2rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
</style>
