---
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).format;
---

<div class="card fmt">
  <p class="eyebrow">{t.eyebrow}</p>
  <h3>{t.title}</h3>
  <div class="lines">
    {t.lines.map((line) => <p>{line}</p>)}
  </div>
</div>

<style>
  .fmt h3 { margin: 0 0 20px; }
  .lines { display: grid; gap: 12px; }
  .lines p { margin: 0; font-size: 0.9375rem; line-height: 1.55; max-width: none; }
</style>
