---
import Button from "../Button.astro";

const fee = "₹500";
const payHref = "#pay";
const heroCta = `Pay ${fee} — hold a seat`;
---

<section id="top" class="hero">
  <div class="wrap grid-2">
    <div>
      <p class="eyebrow">AI Agent Training Program &middot; Cohort 01</p>
      <h1>
        Your town already runs on WhatsApp, registers and paper.<br />
        <span class="gold devanagari">अब एक एजेंट बनाते हैं।</span>
      </h1>
      <p class="lead">
        Nine weeks, three live sessions a week, and you build on the days
        between. Twenty seats, split across two tracks. Built in public
        &mdash; the code, the failures and the numbers all get published.
      </p>
      <p class="sub">
        For college students in Bhiwani and Hisar, and for working IT
        professionals nearby who want to ship an agent instead of watching
        one more course.
      </p>
      <div class="cta-row">
        <Button size="lg" href={payHref}>{heroCta}</Button>
        <Button size="lg" variant="secondary" href="#tracks">See the two tracks</Button>
      </div>
      <p class="fine">{fee}, non-refundable. Registration closes 17 September &mdash; four days before the first session.</p>
    </div>

    <div class="card card-gold offer">
      <p class="eyebrow">The whole offer, in numbers</p>
      <dl>
        <div><dt>Runs</dt><dd>21 Sep &ndash; 19 Nov 2026</dd></div>
        <div><dt>Live sessions</dt><dd>Mon, Wed, Fri &mdash; 26 in all</dd></div>
        <div><dt>Seats</dt><dd>20 seats</dd></div>
        <div><dt>Registration closes</dt><dd>17 September 2026</dd></div>
        <div class="fee-row"><dt>Fee</dt><dd class="fee">{fee}</dd></div>
      </dl>
      <Button size="lg" href={payHref} class="offer-cta">{heroCta}</Button>
      <p class="fine">There is no recording. If you miss a session, you catch up from the build log like everyone else.</p>
    </div>
  </div>
</section>

<style>
  .hero { padding: 72px 24px 64px; background: var(--gradient-navy-depth); }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 56px;
    align-items: start;
  }

  h1 {
    font-size: clamp(2.25rem, 4.4vw, 3rem);
    line-height: 1.02;
    margin: 0 0 20px;
  }

  .devanagari { font-family: var(--font-devanagari); }

  .lead { font-size: 1.125rem; line-height: 1.55; color: var(--text-muted); margin: 0 0 12px; }
  .sub { font-size: 0.9375rem; line-height: 1.55; color: var(--text-subtle); margin: 0 0 32px; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }

  .fine { font-size: 0.75rem; color: var(--text-faint); margin: 20px 0 0; line-height: 1.32; max-width: none; }

  .offer dl { margin: 0 0 20px; display: grid; gap: 0; }
  .offer dl div {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding: 12px 0; border-bottom: 1px solid var(--border-hairline);
  }
  .offer dl div:last-child { border-bottom: 0; }
  .offer dt { font-size: 0.875rem; color: var(--text-subtle); }
  .offer dd { margin: 0; font-size: 1rem; font-weight: 600; color: var(--text-heading); text-align: right; }
  .offer .fee { font-size: 1.375rem; font-weight: 700; color: var(--gold-300); }
  .offer :global(.offer-cta) { width: 100%; margin-top: 0; }
  .offer .fine { margin-top: 16px; }
</style>
