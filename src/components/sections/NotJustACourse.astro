---
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).notJustACourse;
---

<div class="card notcourse">
  <p class="eyebrow">{t.eyebrow}</p>
  <h3>{t.title}</h3>
  <div class="points">
    {t.points.map((p) => <p class="point">{p}</p>)}
  </div>
</div>

<style>
  .notcourse h3 { margin: 0 0 20px; }
  .points { display: grid; gap: 14px; }
  .point {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-muted);
    padding-left: 18px;
    position: relative;
    max-width: none;
  }
  .point::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--gold-400);
  }
</style>
