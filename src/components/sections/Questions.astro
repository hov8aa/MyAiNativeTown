---
const questions = [
  {
    tag: "Kirana & retail",
    q: "Can an agent take the day’s udhaar off a shopkeeper’s notebook and onto his phone?",
  },
  {
    tag: "Coaching institutes",
    q: "Can it answer the same forty admission questions parents ask every evening — in Hindi?",
  },
  {
    tag: "Forms & schemes",
    q: "Can it tell someone which scheme they qualify for, and which four papers to carry?",
  },
  {
    tag: "Clinics",
    q: "Can it hold a clinic’s appointment book without the receptionist changing how she works?",
  },
];
---

<section id="questions" class="questions">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">The four questions</p>
        <h2>Answer one of these by <span class="gold">19 November</span>.</h2>
      </div>
      <p class="deck">
        These are specific to Bhiwani and Hisar on purpose. Generic examples
        kill the premise. The blank line is yours to fill.
      </p>
    </div>
    <div class="grid-4">
      {questions.map((item) => (
        <div class="card qcard">
          <span class="tag">{item.tag}</span>
          <p class="q">{item.q}</p>
          <span class="divider-gold"></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .questions { background: var(--surface-page); }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 40px;
  }

  .deck { font-size: 1rem; color: var(--text-muted); line-height: 1.55; margin: 0; max-width: 38ch; }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .qcard {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: transform 220ms cubic-bezier(0.2,0.7,0.3,1), box-shadow 220ms cubic-bezier(0.2,0.7,0.3,1), border-color 220ms cubic-bezier(0.2,0.7,0.3,1);
  }

  .qcard:hover {
    transform: translateY(-3px);
    border-color: var(--gold-400);
    box-shadow: var(--shadow-gold-glow);
  }

  .tag { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-subtle); }
  .q { margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.32; color: var(--text-heading); max-width: none; }
  .qcard .divider-gold { margin-top: auto; }
</style>
