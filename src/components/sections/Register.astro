---
import Button from "../Button.astro";
import Field from "../Field.astro";

const appFee = "₹500";
const programFee = "₹1,00,000";
const dmHref = "https://wa.me/917015330518?text=AGENT";
const dmCta = `DM "AGENT" to know more`;
const trackOptions = [
  { value: "freshers", label: "Freshers — new to this" },
  { value: "experienced", label: "Experienced — already write code" },
  { value: "unsure", label: "Not sure yet — help me pick" },
];
---

<section id="register" class="register">
  <div class="wrap grid-2">
    <div>
      <p class="eyebrow">Register</p>
      <h2>10 seats. <span class="gold">Ek hi cohort.</span></h2>
      <p class="lead">
        {appFee} gets you in the door. The {programFee} program fee is due
        only after you have a job offer, payable in installments &mdash; it
        is the first filter, and it is the only thing you pay before you're
        hired.
      </p>
      <div class="steps">
        <p><span class="num">1</span>DM &ldquo;AGENT&rdquo; on WhatsApp, or fill this in &mdash; either works.</p>
        <p><span class="num">2</span>I reply within two working days with next steps and the joining link.</p>
        <p><span class="num">3</span>Cohort 01 starts 12 October. Ten seats, first come first held.</p>
      </div>
      <p class="footnote">
        Questions before you apply? Write to me and say whether you're a
        fresher or already working. Vague inputs get vague replies.
      </p>
    </div>

    <div class="card card-gold">
      <form class="form">
        <div class="field-row">
          <Field id="name" label="Your name" placeholder="Hari Om" />
          <Field id="phone" label="WhatsApp number" placeholder="98xxxxxxxx" />
        </div>
        <Field id="place" label="College or company" placeholder="TIT&S Bhiwani" />
        <Field id="track" label="Freshers or experienced" as="select" options={trackOptions} />
        <Field
          id="thing"
          label="What would you point an agent at first?"
          as="textarea"
          placeholder="The shop, clinic or office you already know from the inside."
        />
        <div class="actions">
          <Button size="lg" href={dmHref}>{dmCta}</Button>
          <p class="fine">Opens WhatsApp. {appFee} application fee, and there is no waitlist once ten are in.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .register { background: var(--surface-page); }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 56px;
    align-items: start;
  }

  h2 { margin: 0 0 20px; }
  .lead { font-size: 1.0625rem; line-height: 1.55; margin: 0 0 28px; max-width: 46ch; }

  .steps { display: grid; gap: 14px; margin-bottom: 28px; }
  .steps p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-body);
    padding-left: 26px;
    position: relative;
    max-width: none;
  }
  .steps .num { position: absolute; left: 0; top: 0; color: var(--gold-300); font-weight: 600; }

  .footnote {
    padding-top: 24px;
    border-top: 1px solid var(--border-hairline);
    font-size: 0.875rem;
    color: var(--text-subtle);
    line-height: 1.55;
    margin: 0;
    max-width: none;
  }

  .form { display: grid; gap: 20px; }
  .field-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 20px; }

  .actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .actions .fine { font-size: 0.75rem; color: var(--text-faint); margin: 0; max-width: 34ch; line-height: 1.32; }
</style>
