---
import { copyFor } from "../../i18n";

const t = copyFor(Astro.currentLocale).tracks;
const tracks = [
  { ...t.freshers, cardClass: "card track" },
  { ...t.experienced, cardClass: "card card-gold track" },
];
---

<section id="tracks" class="tracks">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.title}<span class="gold">{t.titleGold}</span>{t.titleEnd}</h2>
      </div>
      <p class="deck">{t.deck}</p>
    </div>
    <div class="grid-2up">
      {tracks.map((track) => (
        <div class={track.cardClass}>
          <span class="badge">{track.badge}</span>
          <h3>{track.title}</h3>
          <p class="body">{track.body}</p>
          <p class="who">{track.who}</p>
          <div class="walk">
            <span>{t.walkLabel}</span>
            <span class="ans">{track.walk}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tracks { background: var(--surface-page); }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 40px;
  }

  .deck { font-size: 1rem; color: var(--text-muted); line-height: 1.55; margin: 0; max-width: 38ch; }

  .grid-2up {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .track { display: flex; flex-direction: column; gap: 16px; }

  .badge {
    align-self: start;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-gold);
    background: var(--gradient-gold);
    border-radius: 14px;
    padding: 6px 14px;
  }

  .track h3 { margin: 0; }
  .body { margin: 0; font-size: 1.0625rem; line-height: 1.55; color: var(--text-muted); max-width: none; }
  .who { margin: 0; font-size: 0.9375rem; line-height: 1.55; color: var(--text-subtle); max-width: none; }

  .walk {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--border-hairline);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--text-subtle);
  }

  .ans { font-size: 1rem; font-weight: 600; color: var(--gold-300); text-align: right; }
</style>
