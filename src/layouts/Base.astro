---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { copyFor, langFrom, languages, pathFor, defaultLang, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  // Pages that exist in every language (the home page). Only these get the
  // language switch, the saved-language redirect and hreflang alternates.
  localized?: boolean;
  // Language of a page that isn't localized; defaults to the route's locale.
  lang?: Lang;
}

const { title, description, localized = false } = Astro.props;
// Each page canonicalises to its own URL (not always the homepage).
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const lang = Astro.props.lang ?? langFrom(Astro.currentLocale);
const t = copyFor(lang);
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(pathFor(l), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Honour a language picked earlier with the header switch (SiteHeader.astro).
         Runs before analytics so a redirected visit isn't counted twice. -->
    {localized && <script is:inline define:vars={{ lang, paths: { hi: pathFor("hi"), en: pathFor("en") } }}>
      try {
        var saved = localStorage.getItem('lang');
        if (saved && saved !== lang && paths[saved]) {
          location.replace(paths[saved] + location.search + location.hash);
        }
      } catch (e) {}
    </script>}
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S8P1T5LCQ8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-S8P1T5LCQ8');

      // DM "AGENT" clicks are the site's conversion: one event, tagged by CTA position.
      document.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('a[data-cta]');
        if (!link) return;
        gtag('event', 'generate_lead', {
          method: 'whatsapp',
          cta_location: link.getAttribute('data-cta'),
          language: document.documentElement.lang,
          transport_type: 'beacon'
        });
      });
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="MyAiNativeTown" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:image" content="https://myainativetown.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://myainativetown.com/og-image.png" />
    <link rel="canonical" href={canonicalURL} />
    {localized && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(pathFor(defaultLang), Astro.site).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <SiteHeader lang={lang} localized={localized} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} />

    <!-- Agentforce chat (Salesforce Embedded Messaging) — answers visitor questions from assets/documents/rag/. -->
    <script is:inline type="text/javascript">
      function initEmbeddedMessaging() {
        try {
          embeddedservice_bootstrap.settings.language = 'en_US';

          embeddedservice_bootstrap.init(
            '00DgL000005LHCf',
            'MyAiNativeTown',
            'https://orgfarm-3a666335d9-dev-ed.develop.my.site.com/ESWMyAiNativeTown1792059388790',
            {
              scrt2URL: 'https://orgfarm-3a666335d9-dev-ed.develop.my.salesforce-scrt.com'
            }
          );
        } catch (err) {
          console.error('Error loading Embedded Messaging: ', err);
        }
      }
    </script>
    <script
      is:inline
      type="text/javascript"
      src="https://orgfarm-3a666335d9-dev-ed.develop.my.site.com/ESWMyAiNativeTown1792059388790/assets/js/bootstrap.min.js"
      onload="initEmbeddedMessaging()"
    ></script>
  </body>
</html>
