---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Questions from "../components/sections/Questions.astro";
import Building from "../components/sections/Building.astro";
import NotJustACourse from "../components/sections/NotJustACourse.astro";
import Tracks from "../components/sections/Tracks.astro";
import Format from "../components/sections/Format.astro";
import Outcomes from "../components/sections/Outcomes.astro";
import DontJoin from "../components/sections/DontJoin.astro";
import Register from "../components/sections/Register.astro";
import Closing from "../components/sections/Closing.astro";
---

<Base
  title="AI Agent Course in Bhiwani & Hisar — Pay After You're Hired"
  description="Build real AI agents in 90 days, online or in Bhiwani & Hisar. Two free sessions, ₹1,000 to register, program fee only after you're hired."
>
  <Hero />
  <Questions />
  <section id="building" class="row-building">
    <div class="wrap grid-2">
      <Building />
      <NotJustACourse />
    </div>
  </section>
  <Tracks />
  <section id="format" class="row-format">
    <div class="wrap grid-3">
      <Format />
      <Outcomes />
      <DontJoin />
    </div>
  </section>
  <Register />
  <Closing />
</Base>

<style>
  .row-building { background: var(--surface-canvas); }
  .row-format { background: var(--surface-canvas); }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 48px;
    align-items: start;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 24px;
  }
</style>
